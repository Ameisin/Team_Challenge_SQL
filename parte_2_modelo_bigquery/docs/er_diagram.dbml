// Definición del modelo de TodoComponentes en DBML (dbdiagram.io)
// Fuente de verdad del diagrama ER. Ver también generate_er_diagram.py (PNG).

Table customers {
  customer_id int [pk, increment]
  first_name string
  last_name string
  email string [unique]
  phone string
  country string
  city string
  acquisition_channel string [note: 'organic | paid_ads | social | referral']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table categories {
  category_id int [pk, increment]
  name string [unique]
  description string
}

Table products {
  product_id int [pk, increment]
  category_id int [ref: > categories.category_id]
  name string
  description string
  brand string
  unit_cost decimal [note: 'coste por unidad, para margen']
  unit_price decimal [note: 'precio de venta actual']
  stock int
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table orders {
  order_id int [pk, increment]
  customer_id int [ref: > customers.customer_id]
  order_status string [note: 'pending|confirmed|shipped|delivered|cancelled|returned']
  shipping_country string
  shipping_city string
  shipping_address string
  order_date timestamp
  shipped_date timestamp [null]
  delivered_date timestamp [null]
}

Table order_items {
  order_item_id int [pk, increment]
  order_id int [ref: > orders.order_id]
  product_id int [ref: > products.product_id]
  quantity int
  unit_price decimal [note: 'precio snapshot en el momento de la compra']
  discount decimal [default: 0]
  line_total decimal
  // restricción UNIQUE(order_id, product_id) declarada en SQL
}

Table payments {
  payment_id int [pk, increment]
  order_id int [ref: > orders.order_id, unique]
  payment_method string
  payment_status string [note: 'completed|refunded|pending|failed']
  amount decimal
  paid_at timestamp
}

Table reviews {
  review_id int [pk, increment]
  order_item_id int [ref: > order_items.order_item_id]
  customer_id int [ref: > customers.customer_id]
  rating int [note: '1..5']
  comment string [null]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

// Relaciones y cardinalidades
Ref r1: orders.customer_id > customers.customer_id
Ref r2: products.category_id > categories.category_id
Ref r3: order_items.order_id > orders.order_id
Ref r4: order_items.product_id > products.product_id
Ref r5: payments.order_id > orders.order_id
Ref r6: reviews.order_item_id > order_items.order_item_id
Ref r7: reviews.customer_id > customers.customer_id
