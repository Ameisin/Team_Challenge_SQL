# Copia este archivo a `.env` y completa los valores locales.
# ¡NUNCA subas el `.env` al repositorio!

# Proyecto de Google Cloud
GCP_PROJECT_ID=tu-proyecto-gcp

# Dataset de BigQuery donde se crea el modelo
BQ_DATASET_ID=todo_componentes

# Ruta al JSON de la Service Account (rol: BigQuery Admin)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
